{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "IdeaTree",
  "version": "0.6.2",
  "identifier": "com.toshiaki0315.ideatree",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "IdeaTree",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["ideatree"],
        "name": "IdeaTree マインドマップ",
        "description": "IdeaTree のマインドマップ",
        "role": "Editor",
        "mimeType": "application/json"
      }
    ]
  }
}
